# ---------------------------------------------------------------------------
# RankRentDeep OS — environment template
# Copy to `.env.local` and fill in the values. Never commit `.env.local`.
# All API credentials live here (Vercel environment variables in production),
# never in the database.
# ---------------------------------------------------------------------------

# --- Supabase ---------------------------------------------------------------
# Project URL + anon key (public, safe for client). Service role key is
# SERVER-ONLY — never expose it with NEXT_PUBLIC_.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# --- App ---------------------------------------------------------------
# Shared secret used to authenticate cron/queue endpoints (/api/cron/*).
CRON_SECRET=

# ---------------------------------------------------------------------------
# SEO data providers. The unified client (src/lib/providers) auto-detects
# which providers are configured and routes each query to the best available
# source. You only need the ones you have keys for.
# ---------------------------------------------------------------------------

# --- DataForSEO (SERP scraping, keyword data, Google Trends, business data) --
DATAFORSEO_LOGIN=
DATAFORSEO_PASSWORD=

# --- Ahrefs (keyword volume, SERP overview, domain rating, backlinks) -------
AHREFS_API_TOKEN=

# --- Semrush (keyword volume, domain analytics, traffic, CPC) ---------------
SEMRUSH_API_KEY=

# --- Google Places (place resolution, business search, autocomplete) --------
GOOGLE_PLACES_API_KEY=

# --- Google Trends (seasonality / interest-over-time) ------------------------
# Optional; DataForSEO Google Trends is used when this is absent.
GOOGLE_TRENDS_DATASOURCE=web

# --- Yelp Fusion (additional renter discovery) -------------------------------
YELP_API_KEY=

# --- US Census ACS (population + median income enrichment) -------------------
CENSUS_API_KEY=

# --- OpenStreetMap / Nominatim (free geocoding fallback) ---------------------
# Nominatim usage policy requires a contact; used in the User-Agent header.
NOMINATIM_EMAIL=

# --- AI committee (multiple models review before a monetary test) ------------
# OpenRouter API key (one key routes to many models).
OPENROUTER_API_KEY=
# Optional: comma-separated OpenRouter model IDs. Roles are auto-assigned in a
# fixed order (underwriter, SEO tech, economist, monetization, red-team).
COMMITTEE_MODELS=deepseek/deepseek-chat,openai/gpt-4o-mini,anthropic/claude-3.5-haiku,google/gemini-flash-1.5,meta-llama/llama-3.1-70b-instruct

# --- Scoring weights (optional override of defaults) ------------------------
# W_DEMAND=0.30
# W_RANKABILITY=0.30
# W_RENTABILITY=0.30
# W_ENTITY=0.10
