{
  "crons": [
    {
      "path": "/api/cron/worker",
      "schedule": "*/5 * * * *"
    },
    {
      "path": "/api/cron/daily",
      "schedule": "0 6 * * *"
    },
    {
      "path": "/api/cron/weekly",
      "schedule": "0 5 * * 1"
    },
    {
      "path": "/api/cron/monthly",
      "schedule": "0 4 1 * *"
    }
  ]
}
